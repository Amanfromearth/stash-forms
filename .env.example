DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
ADMIN_PASSWORD="change-me-to-a-strong-password"
SESSION_SECRET="generate-a-random-64-char-hex-string"
IP_HASH_SALT="generate-a-random-32-char-hex-string"
# Set to a single-IP header that your reverse proxy overwrites (for example x-real-ip).
# Vercel is detected automatically. Without a trusted IP, browser/session limits still apply.
TRUSTED_PROXY_IP_HEADER=""
